{
  "name": "octagram-website",
  "private": true,
  "type": "module",
  "version": "2.0.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 4174",
    "build": "next build --webpack",
    "start": "node serve.mjs",
    "check": "tsc --noEmit",
    "test:e2e": "playwright test",
    "check:models": "node scripts/check_models.mjs",
    "format": "prettier --write src tests *.json *.ts *.mjs scripts/*.mjs"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "gsap": "3.15.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.180.0",
    "lighthouse": "^13",
    "meshoptimizer": "0.22.0",
    "postcss": "8.5.31",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3"
  }
}
